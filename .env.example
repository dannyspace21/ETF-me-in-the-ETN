# Copy to .env and tweak. Everything is optional.

# ---- market data -------------------------------------------------------------
# Tried in order until one returns data. Keyed providers are skipped when their key is empty.
#   no key: yahoo, stooq | key: alpaca, eodhd, tiingo, polygon, fmp, alphavantage
DATA_PROVIDERS=alpaca,yahoo,stooq,eodhd
REFRESH_MINUTES=30
FETCH_CONCURRENCY=8
# Max simultaneous requests to any one API host, and retries for 429 / 5xx / timeouts
PER_HOST_CONCURRENCY=4
HTTP_RETRIES=3
# Peak used for "drawdown from high" = highest close in the last N years (0 = true all-time high)
PEAK_LOOKBACK_YEARS=5
# Offline synthetic data for kicking the tires
DEMO_MODE=false
TIINGO_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
# Global exchange symbol lists + international prices (https://eodhd.com)
EODHD_API_KEY=

# ---- Alpaca (https://alpaca.markets, free account) -----------------------------
# US asset discovery + batched daily bars (100 symbols per request). Paper keys work.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
# sip (consolidated, falls back to iex automatically if your plan lacks it) | iex
ALPACA_DATA_FEED=sip

# ---- discovery: find every leveraged ETF / ETN / ETP ----------------------------
# No key: nasdaqtrader (US), tsx (Canada), twse + tpex (Taiwan), krx (Korea), hkex (Hong Kong),
#         jpx (Japan, this year's launches), yahoo (worldwide search, best effort)
# Key:    alpaca (US), eodhd (every exchange in EODHD_EXCHANGES), fmp (global ETF list)
DISCOVERY_SOURCES=nasdaqtrader,alpaca,tsx,twse,tpex,krx,hkex,jpx,yahoo,eodhd,fmp
DISCOVERY_HOURS=12
DISCOVERY_INCLUDE_INVERSE=true
DISCOVERY_MIN_LEVERAGE=1.25
# Empty = every market. ISO codes, e.g. US,GB,DE,CA,HK,JP,KR,TW,AU
DISCOVERY_COUNTRIES=
DISCOVERY_DELIST_DAYS=7
EODHD_EXCHANGES=LSE,XETRA,PA,AS,MI,SW,TO,NEO,HK,KO,KQ,TW,AU,TSE,ST

# ---- notifications (comma separated) ----------------------------------------
# Discord / Slack webhooks, ntfy topics (https://ntfy.sh/my-topic), or any URL that accepts JSON POSTs
NOTIFY_URLS=
# Only push tier alerts at or above this level (chill|clench|shock|brown|allin). Empty = all.
# With thousands of funds tracked, "brown" keeps your phone sane. Starred (watchlist) funds always push.
NOTIFY_MIN_TIER=
# Push a notification when a new leveraged fund lists
NOTIFY_NEW_FUNDS=true

# ---- AI agents ---------------------------------------------------------------
# If set, POST endpoints require header  X-API-Key: <one of these>
AGENT_API_KEYS=
# Server-side LLM for "Ask the AI": none | ollama | openai | anthropic
#   ollama  -> local & offline (docker compose --profile ai up -d)
#   openai  -> any OpenAI-compatible endpoint: OpenAI, LM Studio, vLLM, llama.cpp, OpenRouter, Groq...
LLM_PROVIDER=none
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=
LLM_API_KEY=
